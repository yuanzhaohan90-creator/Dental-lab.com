{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.yzhdentallab.com"
        }
      ],
      "destination": "https://yzhdentallab.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/implant-restorations",
      "destination": "/implant-restorations.html"
    },
    {
      "source": "/full-arch-all-on-x",
      "destination": "/full-arch-all-on-x.html"
    },
    {
      "source": "/crown-bridge",
      "destination": "/crown-bridge.html"
    },
    {
      "source": "/digital-dentistry",
      "destination": "/digital-dentistry.html"
    },
    {
      "source": "/surgical-guides",
      "destination": "/surgical-guides.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/submit-case",
      "destination": "/submit-case.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    }
  ]
}

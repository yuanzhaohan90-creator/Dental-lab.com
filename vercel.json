{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.yzhdentallab.com"
        }
      ],
      "destination": "https://yzhdentallab.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/implant-restorations",
      "destination": "/implant-restorations.html"
    },
    {
      "source": "/full-arch-all-on-x",
      "destination": "/full-arch-all-on-x.html"
    },
    {
      "source": "/cases/dual-arch-all-on-x",
      "destination": "/cases/dual-arch-all-on-x/index.html"
    },
    {
      "source": "/cases",
      "destination": "/cases.html"
    },
    {
      "source": "/cases/:slug",
      "destination": "/api/case-page?slug=:slug"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/cases",
      "destination": "/admin/cases.html"
    },
    {
      "source": "/admin/home",
      "destination": "/admin/home.html"
    },
    {
      "source": "/admin/implant",
      "destination": "/admin/implant.html"
    },
    {
      "source": "/admin/full-arch",
      "destination": "/admin/full-arch.html"
    },
    {
      "source": "/admin/about",
      "destination": "/admin/about.html"
    },
    {
      "source": "/admin/submissions",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/media",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/homepage",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/settings",
      "destination": "/admin/index.html"
    },
    {
      "source": "/full-arch/zirconia-titanium-workflow",
      "destination": "/full-arch/zirconia-titanium-workflow/index.html"
    },
    {
      "source": "/full-arch/immediate-load-pmma",
      "destination": "/full-arch/immediate-load-pmma/index.html"
    },
    {
      "source": "/full-arch/photogrammetry-workflow",
      "destination": "/full-arch/photogrammetry-workflow/index.html"
    },
    {
      "source": "/full-arch/fp1-full-arch-zirconia",
      "destination": "/full-arch/fp1-full-arch-zirconia/index.html"
    },
    {
      "source": "/full-arch/complex-zygomatic-workflow",
      "destination": "/full-arch/complex-zygomatic-workflow/index.html"
    },
    {
      "source": "/crown-bridge",
      "destination": "/crown-bridge.html"
    },
    {
      "source": "/digital-dentistry",
      "destination": "/digital-dentistry.html"
    },
    {
      "source": "/surgical-guides",
      "destination": "/surgical-guides.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/submit-case",
      "destination": "/submit-case.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    }
  ]
}

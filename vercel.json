{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/public-page.js": {
      "includeFiles": "templates/**"
    },
    "api/video-process.js": {
      "maxDuration": 300
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.yzhdentallab.com"
        }
      ],
      "destination": "https://yzhdentallab.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/public-page?page=home"
    },
    {
      "source": "/implant-restorations",
      "destination": "/api/public-page?page=implant"
    },
    {
      "source": "/full-arch-all-on-x",
      "destination": "/api/public-page?page=fullArch"
    },
    {
      "source": "/cases",
      "destination": "/api/public-page?page=cases"
    },
    {
      "source": "/cases/:slug",
      "destination": "/api/case-page?slug=:slug"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/cases",
      "destination": "/admin/cases.html"
    },
    {
      "source": "/admin/home",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/implant",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/full-arch",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/about",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/submissions",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/media",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/homepage",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/settings",
      "destination": "/admin/index.html"
    },
    {
      "source": "/crown-bridge",
      "destination": "/api/public-page?page=crownBridge"
    },
    {
      "source": "/digital-dentistry",
      "destination": "/api/public-page?page=digital"
    },
    {
      "source": "/surgical-guides",
      "destination": "/api/public-page?page=surgicalGuides"
    },
    {
      "source": "/about",
      "destination": "/api/public-page?page=about"
    },
    {
      "source": "/submit-case",
      "destination": "/api/public-page?page=submitCase"
    },
    {
      "source": "/privacy-policy",
      "destination": "/api/public-page?page=privacy"
    }
  ]
}

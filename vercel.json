{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.yzhdentallab.com"
        }
      ],
      "destination": "https://yzhdentallab.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/implant-restorations",
      "destination": "/index.html"
    },
    {
      "source": "/full-arch-all-on-x",
      "destination": "/index.html"
    },
    {
      "source": "/cad-design",
      "destination": "/index.html"
    },
    {
      "source": "/custom-abutments",
      "destination": "/index.html"
    },
    {
      "source": "/overflow-production",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    }
  ]
}
